# Commands run by the launchd job com.redwood.demo (see com.redwood.demo.plist), for the G981B (RC_JOBS=rc.jobs.x1s).
# First what the Storage page is computed from (early: the saved log fills up), then the package manager's
# preparation once per boot (tools/x1s/mk-jb-win.py's prep.sh: dpkg's database, uicache) and what the tweak loader has.
/redwood/bin/mg_test statfs DiskUsage
/var/jb/bin/sh /var/jb/prep.sh
/var/jb/usr/bin/dpkg-query -W -f${binary:Package}_${Version}_${Status}\n preferenceloader ellekit com.mrgcgamer.floatingdock
/var/jb/bin/ls -la /var/jb/usr/lib/TweakInject/
/var/jb/bin/sh /var/jb/etc/x1s-eagl.sh
